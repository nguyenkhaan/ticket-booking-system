{
  "info": {
    "name": "Concert Ticket Booking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local API testing collection for the NestJS concert ticket booking backend."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer@booking-system.com\",\n  \"password\": \"password123\"\n}"
        }
      }
    },
    {
      "name": "List Concerts",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/concerts"
      }
    },
    {
      "name": "List Tickets By Concert",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/tickets/concert/demo-concert-001"
      }
    },
    {
      "name": "Validate Voucher",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/vouchers/validate",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"SUMMER20\",\n  \"orderAmount\": 300\n}"
        }
      }
    },
    {
      "name": "Create Booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"ticketCategoryId\": \"ticket-standard-001\",\n      \"quantity\": 2\n    }\n  ],\n  \"voucherCode\": \"SUMMER20\"\n}"
        }
      }
    },
    {
      "name": "Get Booking",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/bookings/{{bookingId}}"
      }
    },
    {
      "name": "Create Payment",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/payments/booking/{{bookingId}}"
      }
    },
    {
      "name": "Payment Webhook Success",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/payments/{{bookingId}}/webhook",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"SUCCESS\",\n  \"providerRef\": \"mock-provider-reference\"\n}"
        }
      }
    },
    {
      "name": "Health Liveness",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health/liveness"
      }
    }
  ]
}
