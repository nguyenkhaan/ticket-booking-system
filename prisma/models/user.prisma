model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  fullName      String?
  role          UserRole  @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  concerts      Concert[]
  bookings      Booking[]
  voucherRedemptions VoucherRedemption[]
  auditLogs     AuditLog[]

  @@map("users")
  @@index([email])
}
